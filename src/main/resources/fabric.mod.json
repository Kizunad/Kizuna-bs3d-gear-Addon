{
  "schemaVersion": 1,
  "id": "bs3d_gear",
  "version": "${version}",
  "name": "Kizuna BS3D Gear Addon",
  "authors": ["Kizunad"],
  "contact": {
    "homepage": "https://github.com/Kizunad/Kizuna-bs3d-gear-Addon",
    "sources": "https://github.com/Kizunad/Kizuna-bs3d-gear-Addon",
